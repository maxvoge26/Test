<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Anmelden</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>
  <h1>Anmelden</h1>
  <input id="email" type="email" placeholder="E-Mail">
  <input id="passwort" type="password" placeholder="Passwort">
  <button onclick="anmelden()">Anmelden</button>
  <button onclick="registrieren()">Registrieren</button>
  <p id="meldung"></p>

  <script>
    const sb = supabase.createClient("DEINE_PROJECT_URL", "DEIN_ANON_KEY");
    const meldung = document.getElementById("meldung");

    async function registrieren() {
      const { error } = await sb.auth.signUp({
        email: document.getElementById("email").value,
        password: document.getElementById("passwort").value
      });
      meldung.textContent = error ? error.message : "Bitte bestätige deine E-Mail.";
    }

    async function anmelden() {
      const { error } = await sb.auth.signInWithPassword({
        email: document.getElementById("email").value,
        password: document.getElementById("passwort").value
      });
      meldung.textContent = error ? error.message : "Angemeldet!";
    }
  </script>
</body>
</html>
